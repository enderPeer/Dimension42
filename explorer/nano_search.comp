#version 450
// "Which programs answer 2 + 2 = 4?"  Vulkan version of pass 1 in nano_search.cu (same rules).
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Cand { uint64_t cand[]; };
// cnt: 0 ncand (whole range) | 1 says4 2 add 3 const 4 mul 5 twoa 6 twob 7 other 8 overflow (per submission)
layout(std430, binding = 1) buffer Cnt { uint cnt[]; };
layout(push_constant) uniform Push { uint L; uint start_lo; uint start_hi; uint count; uint cap; uint ca; uint cb; } pc;

const uint PA[32] = uint[](0u,0u,1u,1u,2u,3u,3u,5u,1u,255u,128u,100u,7u,250u,17u,4u,9u,0u,200u,13u,31u,255u,64u,32u,6u,1u,77u,123u,2u,0u,11u,2u);
const uint PB[32] = uint[](0u,1u,0u,1u,3u,2u,5u,3u,255u,1u,128u,55u,250u,7u,4u,17u,9u,200u,0u,31u,13u,255u,32u,64u,1u,6u,123u,77u,0u,2u,2u,11u);

shared uint s[8];

uint getb(uint m0, uint m1, uint m2, uint m3, uint n) {
    uint w = n < 4u ? m0 : n < 8u ? m1 : n < 12u ? m2 : m3;
    return (w >> ((n & 3u) * 8u)) & 255u;
}

int run_io(uint64_t p, uint L, uint a, uint b) {
    uint prog0 = 0u, prog1 = 0u;
    for (uint i = 0u; i < L; i++) {
        uint v = uint(p >> (8u * (L - 1u - i))) & 255u;
        if (i < 4u) prog0 |= v << (8u * i); else prog1 |= v << (8u * (i - 4u));
    }
    uint m[4] = uint[](prog0, prog1, 0u, 0u);
    m[pc.ca >> 2] = (m[pc.ca >> 2] & ~(255u << ((pc.ca & 3u) * 8u))) | (a << ((pc.ca & 3u) * 8u));
    m[pc.cb >> 2] = (m[pc.cb >> 2] & ~(255u << ((pc.cb & 3u) * 8u))) | (b << ((pc.cb & 3u) * 8u));
    uint m0 = m[0], m1 = m[1], m2 = m[2], m3 = m[3];
    uint A = 0u, pcr = 0u;
    for (uint steps = 0u; steps < 64u; steps++) {
        uint ins = ((pcr < 4u ? m0 : m1) >> ((pcr & 3u) * 8u)) & 255u;
        pcr = pcr + 1u >= L ? 0u : pcr + 1u;
        uint op = ins >> 4, n = ins & 15u;
        if (op == 15u) return -1;
        uint val = getb(m0, m1, m2, m3, n);
        if (op == 13u) return int(val);
        uint k = n & 7u;
        uint rol = ((A << k) | (A >> (8u - k))) & 255u;
        uint nA = A;
        nA = op == 1u ? n : nA;
        nA = op == 2u ? A + n : nA;
        nA = op == 3u ? A - n : nA;
        nA = op == 4u ? val : nA;
        nA = op == 6u ? A + val : nA;
        nA = op == 11u ? rol : nA;
        nA = op == 12u ? (A ^ val) : nA;
        uint wr = op == 5u ? A : op == 9u ? val + 1u : op == 10u ? val - 1u : ~val;
        bool dow = op == 5u || op == 9u || op == 10u || op == 14u;
        uint sh = (n & 3u) * 8u, keep = ~(255u << sh), put = (wr & 255u) << sh, wi = n >> 2;
        m0 = dow && wi == 0u ? (m0 & keep) | put : m0;
        m1 = dow && wi == 1u ? (m1 & keep) | put : m1;
        m2 = dow && wi == 2u ? (m2 & keep) | put : m2;
        m3 = dow && wi == 3u ? (m3 & keep) | put : m3;
        pcr = (op == 7u || (op == 8u && A == 0u)) ? n % L : pcr;
        A = nA & 255u;
    }
    return -1;
}

void main() {
    uint lid = gl_LocalInvocationIndex;
    if (lid < 8u) s[lid] = 0u;
    barrier();
    uint64_t start = (uint64_t(pc.start_hi) << 32) | uint64_t(pc.start_lo);
    uint c_says = 0u, c_add = 0u, c_const = 0u, c_mul = 0u, c_2a = 0u, c_2b = 0u, c_other = 0u, c_over = 0u;
    for (uint j = 0u; j < 4u; j++) {
        uint idx = gl_GlobalInvocationID.x * 4u + j;
        if (idx >= pc.count) break;
        uint64_t p = start + uint64_t(idx);
        if (run_io(p, pc.L, 2u, 2u) != 4) continue;
        c_says++;
        bool fadd = true, fconst = true, fmul = true, f2a = true, f2b = true;
        for (uint t = 0u; t < 32u && (fadd || fconst || fmul || f2a || f2b); t++) {
            uint a = PA[t], b = PB[t];
            int o = run_io(p, pc.L, a, b);
            fadd = fadd && o == int((a + b) & 255u);
            fconst = fconst && o == 4;
            fmul = fmul && o == int((a * b) & 255u);
            f2a = f2a && o == int((2u * a) & 255u);
            f2b = f2b && o == int((2u * b) & 255u);
        }
        if (fadd) {
            c_add++;
            uint at = atomicAdd(cnt[0], 1u);
            if (at < pc.cap) cand[at] = p; else c_over++;
        } else if (fconst) c_const++;
        else if (fmul) c_mul++;
        else if (f2a) c_2a++;
        else if (f2b) c_2b++;
        else c_other++;
    }
    atomicAdd(s[1], c_says); atomicAdd(s[2], c_add); atomicAdd(s[3], c_const); atomicAdd(s[4], c_mul);
    atomicAdd(s[5], c_2a); atomicAdd(s[6], c_2b); atomicAdd(s[7], c_other); atomicAdd(s[0], c_over);
    barrier();
    if (lid == 0u) {
        for (uint q = 1u; q < 8u; q++) if (s[q] != 0u) atomicAdd(cnt[q], s[q]);
        if (s[0] != 0u) atomicAdd(cnt[8], s[0]);
    }
}
