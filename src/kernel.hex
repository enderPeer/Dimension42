66 B8 00 00 01 00   ; mov  eax, 0x10000
66 EF               ; out  dx, eax
83 C2 0C            ; add  dx, 0x0C            IMR
31 C0               ; xor  ax, ax
EF                  ; out  dx, ax
83 C2 08            ; add  dx, 0x08            RCR
66 B8 8F 00 00 00   ; mov  eax, 0x8F           accept all + WRAP
66 EF               ; out  dx, eax
=014C
8B 16 00 8A         ; mov  dx, [iobase]
83 C2 37            ; add  dx, 0x37
B0 0C               ; mov  al, 0x0C
EE                  ; out  dx, al              RX + TX on
