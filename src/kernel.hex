; ===================== tx: EAX = frame address, CX = length ==========
>0240
8B 16 00 8A         ; mov  dx, [iobase]
0F B6 1E 03 8A      ; movzx bx, byte [txidx]
C1 E3 02            ; shl  bx, 2
01 DA               ; add  dx, bx
83 C2 20            ; add  dx, 0x20            TSAD[n]
66 EF               ; out  dx, eax
83 EA 10            ; sub  dx, 0x10            TSD[n]
66 0F B7 C1         ; movzx eax, cx
66 EF               ; out  dx, eax             go
FE 06 03 8A         ; inc  byte [txidx]
80 26 03 8A 03      ; and  byte [txidx], 3
C3                  ; ret
=0266

; ===================== send: heartbeat + one results frame ===========
;  cycles through 4 frames: byte half 0, byte half 1, bit half 0, bit half 1
>0280
83 3E 00 8A 00      ; cmp  word [iobase], 0
74 5C               ; je   ret                 no network
66 B8 20 8A 00 00   ; mov  eax, heartbeat frame
B9 3C 00            ; mov  cx, 60
E8 AD FF            ; call tx
=0293
0F B6 06 02 8A      ; movzx ax, byte [myid]
85 C0               ; test ax, ax
74 47               ; jz   ret
48                  ; dec  ax
C1 E0 06            ; shl  ax, 6               first program = (id-1)*64
FE 06 13 8A         ; inc  byte [txcycle]
8A 1E 13 8A         ; mov  bl, [txcycle]
F6 C3 01            ; test bl, 1
74 03               ; jz   +3
83 C0 20            ; add  ax, 32              second half
=02B0
A2 13 E0            ; mov  [0xE013], al        first program in frame
89 C6               ; mov  si, ax
C1 E6 05            ; shl  si, 5
C6 06 12 E0 52      ; mov  byte [0xE012], 'R'  byte results
81 C6 00 C0         ; add  si, 0xC000
F6 C3 02            ; test bl, 2
74 09               ; jz   +9
C6 06 12 E0 42      ; mov  byte [0xE012], 'B'  bit results
81 C6 00 60         ; add  si, 0x6000          0xC000+0x6000 wraps to 0x2000
=02CF
BF 14 E0            ; mov  di, 0xE014
B9 00 04            ; mov  cx, 1024            32 records
F3 A4               ; rep  movsb
66 B8 00 E0 00 00   ; mov  eax, 0xE000
B9 14 04            ; mov  cx, 0x414           frame length
E8 5D FF            ; call tx
=02E3
C3                  ; ret

