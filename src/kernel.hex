C1 E7 05            ; shl  di, 5
81 C7 00 20         ; add  di, 0x2000          DI -> record
B3 06               ; mov  bl, 6               DRAW?
BE 80 06            ; mov  si, tape
B9 08 00            ; mov  cx, 8
