BF 00 E0            ; mov  di, 0xE000          results frame
B9 12 00            ; mov  cx, 18              copy dst, src, type, "D42", id
F3 A4               ; rep  movsb
C6 06 12 E0 52      ; mov  byte [0xE012], 'R'

