; =====================================================================
;  DIMENSION42 OS  -  KERNEL v0.3   (loaded at 0000:8000, 16-bit real mode)
; =====================================================================
;  Pure x86 machine code, hand-encoded. Offsets are relative to 0x8000.
;
;  v0.1  cluster heartbeat: 4 PCs find each other over ethernet
;  v0.2  PROGRAM EXPLORER: every 1-byte program for the NANO CPU is run,
;        classified and shown in a viewer. The 256 programs are split
;        across the cluster (64 per node) and results are shared over
;        the network, so every node shows the complete map.
;
;  NANO CPU (simulated inside the kernel)
;    16 bytes memory M0..MF, program loaded at M0, register A, PC.
;    Instruction byte = op (high nibble) + n (low nibble).
;      0 NOP          4 LD  A=M[n]     8 JZ  if A=0 PC=n   C XOR A^=M[n]
;      1 LDI A=n      5 ST  M[n]=A     9 INC M[n]++        D OUT output M[n]
;      2 ADDI A+=n    6 ADD A+=M[n]    A DEC M[n]--        E NOT M[n]=~M[n]
;      3 SUBI A-=n    7 JMP PC=n       B ROL A rotl n      F HLT
;    PC wraps at program length (1), so a 1-byte program repeats forever.
;    Runs 64 steps. M8..MF = 8x8 pixel display (one byte per row).
;    Programs can modify themselves (M0 is the program).
;
;  CLASSES (highest that applies)
;    6 DRAW      display was lit at some step
;    5 OUTPUT    produced output
;    4 SELF-MOD  program byte changed
;    3 ACTIVE    A or M1..M7 non-zero at some step
;    2 HALT      stopped by HLT
;    1 IDLE      nothing happened
;    0 PENDING   result not yet received from its node
;
;  RESULT RECORD (32 bytes, table at 0xC000 + prog*32)
;    +0 class  +1 final A  +2 steps  +3 output count  +4 final M0
;    +5 node that computed it   +8..15 first 8 outputs
;    +16..23 final M0..M7      +24..31 display, OR of all 64 steps
;
;  KERNEL LAYOUT                   MEMORY MAP
;    0000 init                       0600 NANO CPU state
;    0200 main loop                  7C00 boot sector
;    0240 tx (EAX=buf, CX=len)       8000 kernel
;    0280 send heartbeat+results     C000 result table (8 KiB)
;    0300 net_poll                   E000 results frame buffer
;    03C0 key_handle                 10000 NIC receive ring
;    0400 draw_status                B8000 text screen (GS)
;    0480 draw_grid
;    0500 draw_detail                NANO STATE (0x06xx)
;    06C0 print SI DI AH               00-0F M  10 A  11 PC  12 steps
;    06D0 hexchar AL                   13 outcnt  14 halted  18-1F outputs
;    06E0 hexbyte AL AH DI             40-4F trace(OR of M)  50 trace(A)
;    0700 hexrow SI CX AH DI           60 prog  61 proglen  70 cur  72 end
;    0710 explore
;    0760 nano_run + instructions
;    0900 nano_done: classify, store record
;    0A00 data
;
;  CLUSTER PROTOCOL v2 (ethertype 0x88B5)  payload: "D42" id type ...
;    type 00 heartbeat (every second)
;    type 'R' results: +1 first program, then 32 records (1024 bytes)
; =====================================================================

; ===================== INIT ==========================================
=0000
FC                  ; cld
FB                  ; sti
31 C0               ; xor  ax, ax
8E D8               ; mov  ds, ax
8E C0               ; mov  es, ax
B8 00 B8            ; mov  ax, 0xB800
8E E8               ; mov  gs, ax              GS -> text screen
B4 01               ; mov  ah, 0x01
B9 00 20            ; mov  cx, 0x2000
CD 10               ; int  0x10                hide cursor
31 FF               ; xor  di, di
B8 20 1F            ; mov  ax, 0x1F20
