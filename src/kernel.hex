; =====================================================================
;  v0.3  BIT PROGRAMS
; =====================================================================
;  BIT CPU: every instruction is ONE bit.
;    0 = FLIP the pixel under the head
;    1 = MOVE the head one pixel right (64 pixels, wraps)
;  The 8x8 display is a 64-pixel tape, read row by row.
;  A program of L bits repeats for 128 steps.
;  Grid index encodes the program: a leading 1 marks the length,
;  the bits after it are the program, e.g.
;    02 = 10b       -> "0"        03 = 11b       -> "1"
;    05 = 101b      -> "01"       FF = 11111111b -> "1111111"
;  so cells 02..FF hold every program of 1 to 7 bits (254 programs).
;  Classes: DRAW (final display not empty), ACTIVE (pixels were lit
;  but the display ended empty, e.g. blinking), IDLE (nothing lit).
;
;  BIT CPU STATE (0x06xx)
;    80-87 display/tape  88 head  89 flips  8A PC  8B steps  8C length
;    90 program index
;  BIT RECORD (32 bytes, table at 0x2000 + index*32)
;    +0 class  +1 head  +2 steps  +3 flips  +4 length  +5 node
;    +24..31 final display

; ===================== bit_run: simulate one bit program =============
>0E00
BF 80 06            ; mov  di, tape
B9 08 00            ; mov  cx, 8
31 C0               ; xor  ax, ax
F3 AB               ; rep  stosw               clear 0680..068F
A0 90 06            ; mov  al, [index]
=0E0D
3C 01               ; cmp  al, 1               length = position of the leading 1
76 08               ; jbe  +8
D0 E8               ; shr  al, 1
FE 06 8C 06         ; inc  byte [length]
EB F4               ; jmp  0x0E0D
=0E19
80 3E 8C 06 00      ; cmp  byte [length], 0
74 56               ; je   done                empty program
=0E20
80 3E 8B 06 80      ; cmp  byte [steps], 128
73 4F               ; jae  done
FE 06 8B 06         ; inc  byte [steps]
8A 0E 8C 06         ; mov  cl, [length]
2A 0E 8A 06         ; sub  cl, [PC]
FE C9               ; dec  cl                  bit number = length-1-PC
A0 90 06            ; mov  al, [index]
D2 E8               ; shr  al, cl
A8 01               ; test al, 1
75 1B               ; jnz  move
0F B6 1E 88 06      ; movzx bx, byte [head]    FLIP:
88 D9               ; mov  cl, bl
80 E1 07            ; and  cl, 7
C1 EB 03            ; shr  bx, 3               byte = head/8
B0 80               ; mov  al, 0x80
D2 E8               ; shr  al, cl              bit  = head%8
30 87 80 06         ; xor  [tape+bx], al
FE 06 89 06         ; inc  byte [flips]
EB 09               ; jmp  next
=0E59
FE 06 88 06         ; inc  byte [head]         MOVE:
80 26 88 06 3F      ; and  byte [head], 63
=0E62
FE 06 8A 06         ; inc  byte [PC]           next:
A0 8A 06            ; mov  al, [PC]
3A 06 8C 06         ; cmp  al, [length]
72 B1               ; jb   step
C6 06 8A 06 00      ; mov  byte [PC], 0        wrap: program repeats
EB AA               ; jmp  step
=0E76
