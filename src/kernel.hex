25 FC FF            ; and  ax, 0xFFFC
A3 00 8A            ; mov  [iobase], ax
89 C2               ; mov  dx, ax
BF 26 8A            ; mov  di, frame.src
B9 06 00            ; mov  cx, 6
=00FF
EC                  ; in   al, dx
AA                  ; stosb
42                  ; inc  dx
E2 FB               ; loop 0x00FF
